CODEINTEL_DATA_DIR=./data
CODEINTEL_API_KEY=                     # set to require X-API-Key on every request
CODEINTEL_ALLOW_LOCAL_PATHS=false      # true only for trusted local dev
CODEINTEL_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
CODEINTEL_MAX_REPO_MB=200
CODEINTEL_MAX_FILES=5000
CODEINTEL_MAX_FILE_KB=512
CODEINTEL_EMBEDDINGS=auto              # auto | hash | st
CODEINTEL_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
CODEINTEL_OLLAMA_URL=http://localhost:11434
CODEINTEL_OLLAMA_MODEL=qwen2.5-coder:7b
CODEINTEL_LLM=auto                     # auto | ollama | none
CODEINTEL_SEMGREP_CONFIG=              # e.g. ./semgrep_rules or p/python
CODEINTEL_API_URL=http://localhost:8000
